{
  "name": "@falkenslab/agent-kit",
  "version": "0.14.0",
  "description": "Library for building an agent on top of the Claude Agent SDK",
  "author": "Francisco Vargas Ruiz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkenslab/agent-kit.git"
  },
  "homepage": "https://github.com/falkenslab/agent-kit#readme",
  "bugs": {
    "url": "https://github.com/falkenslab/agent-kit/issues"
  },
  "keywords": [
    "claude",
    "claude-agent-sdk",
    "ai-agent",
    "agent",
    "anthropic",
    "ink",
    "tui",
    "cli",
    "human-in-the-loop",
    "mcp"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "lint": "eslint .",
    "docs:install": "npm --prefix docs ci",
    "docs:start": "npm --prefix docs start",
    "docs:build": "npm --prefix docs run build",
    "docs:version": "npm --prefix docs run docs:version --",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.234",
    "@inkjs/ui": "^2.0.0",
    "@inquirer/prompts": "^8.5.2",
    "@types/react": "^19.3.0",
    "ink": "^6.8.0",
    "marked": "^18.0.14",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "slice-ansi": "^8.0.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "publishConfig": {
    "access": "public"
  }
}
