{
  "name": "@falkenslab/agent-kit",
  "version": "0.10.0",
  "private": true,
  "description": "Library for building an agent on top of the Claude Agent SDK",
  "author": "Francisco Vargas Ruiz",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.234",
    "@inkjs/ui": "^2.0.0",
    "@inquirer/prompts": "^8.5.2",
    "@types/react": "^19.3.0",
    "ink": "^6.8.0",
    "marked": "^18.0.14",
    "picocolors": "^1.1.1",
    "react": "^19.3.0",
    "slice-ansi": "^8.0.0",
    "string-width": "^8.3.0",
    "wrap-ansi": "^9.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
