{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://falkenslab.github.io/agent-kit/schemas/marketplace-catalog.schema.json",
  "title": "A marketplace's catalog.json",
  "description": "A Claude Code marketplace's extensions as one file, for a page or a client to show without cloning the repository: written by @falkenslab/agent-kit-catalog from .claude-plugin/marketplace.json and each extension's plugin.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["marketplace", "description", "repository", "add", "extensions"],
  "properties": {
    "marketplace": { "description": "The marketplace's name, as <extension>@<marketplace> names an extension.", "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "repository": { "description": "The GitHub repository's page.", "type": "string", "pattern": "^https://github\\.com/[\\w.-]+/[\\w.-]+$" },
    "add": {
      "description": "How to add the marketplace.",
      "type": "object",
      "additionalProperties": false,
      "required": ["claudeCode", "agentKit"],
      "properties": {
        "claudeCode": { "type": "string" },
        "agentKit": { "description": "After the agent's own command (<agent> …).", "type": "string" }
      }
    },
    "extensions": {
      "description": "Sorted by name.",
      "type": "array",
      "items": { "$ref": "#/$defs/extension" }
    }
  },
  "$defs": {
    "url": { "type": "string", "pattern": "^https://" },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "description", "category", "topics", "author", "license", "homepage", "readme", "install"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "version": { "description": "Its plugin.json's, the same as its marketplace entry's.", "type": "string", "minLength": 1 },
        "description": { "description": "In English: its marketplace entry's, else its plugin.json's.", "type": "string" },
        "descriptions": {
          "description": "Its description per language, English among them; only when it has one in another language.",
          "type": "object",
          "propertyNames": { "enum": ["en", "es", "fr", "de"] },
          "required": ["en"],
          "additionalProperties": { "type": "string" }
        },
        "category": { "type": ["string", "null"] },
        "topics": {
          "description": "Its plugin.json's keywords and its entry's tags, keywords and category, lowercased, without repeats.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[^A-Z]+$" }
        },
        "author": { "type": ["string", "null"] },
        "license": { "type": ["string", "null"] },
        "homepage": { "$ref": "#/$defs/url" },
        "readme": { "$ref": "#/$defs/url" },
        "readmes": {
          "description": "Its README per language (README.md, README.es.md…), as URLs; only when it has one in another language.",
          "type": "object",
          "propertyNames": { "enum": ["en", "es", "fr", "de"] },
          "required": ["en"],
          "additionalProperties": { "$ref": "#/$defs/url" }
        },
        "install": {
          "type": "object",
          "additionalProperties": false,
          "required": ["claudeCode", "agentKit"],
          "properties": {
            "claudeCode": { "type": "string" },
            "agentKit": { "description": "After the agent's own command (<agent> …).", "type": "string" }
          }
        },
        "capabilities": {
          "description": "What it lets the agent do: its metadata[\"agent-kit\"].capabilities as it declares them, texts in every language it gives.",
          "type": "array",
          "items": { "$ref": "https://falkenslab.github.io/agent-kit/schemas/agent-kit-metadata.schema.json#/$defs/capability" }
        },
        "requirements": {
          "description": "The programs it needs on the computer: its metadata[\"agent-kit\"].requirements as it declares them.",
          "type": "array",
          "items": { "$ref": "https://falkenslab.github.io/agent-kit/schemas/agent-kit-metadata.schema.json#/$defs/requirement" }
        },
        "logo": { "description": "A URL anyone can load.", "$ref": "#/$defs/url" },
        "banner": { "description": "A URL anyone can load.", "$ref": "#/$defs/url" }
      }
    }
  }
}
