{
  "name": "@falkenslab/agent-kit-catalog",
  "version": "0.1.0",
  "description": "A Claude Code marketplace's extensions as one catalog.json, for a page or a client to show them: name, version, topics, install commands and images. No dependencies.",
  "keywords": [
    "claude-code",
    "marketplace",
    "plugins",
    "catalog",
    "agent-kit"
  ],
  "license": "MIT",
  "author": "Falkenslab",
  "homepage": "https://falkenslab.github.io/agent-kit/docs/extensions/publishing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/falkenslab/agent-kit.git",
    "directory": "packages/agent-kit-catalog"
  },
  "type": "module",
  "bin": {
    "agent-kit-catalog": "agent-kit-catalog.mjs"
  },
  "exports": {
    ".": {
      "types": "./agent-kit-catalog.d.mts",
      "default": "./agent-kit-catalog.mjs"
    }
  },
  "files": [
    "agent-kit-catalog.mjs",
    "agent-kit-catalog.d.mts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "agent-kit-catalog.d.mts"
}
